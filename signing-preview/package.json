{
  "name": "signing-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Human-readable previews of EVM and Hyperliquid signing requests (Ethereum, Arbitrum, HyperEVM, HyperCore)",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "exports": {
    ".": "./src/index.ts",
    "./interceptor": "./src/interceptor.ts"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "npm run build && node src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "viem": "2.57.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
